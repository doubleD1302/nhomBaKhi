PORT=3000

# Connection string kết nối Supabase PostgreSQL qua Connection Pooler (cổng 5432 hoặc 6543)
# Tương thích 100% với IPv4 trên Render theo đúng cảnh báo Mục B.3 trong tài liệu môn học
# Thay YOUR_DB_PASSWORD bằng mật khẩu bạn đã đặt khi tạo dự án
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres

# API & Storage Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Khóa secret key cho backend upload file/storage (Lấy từ Supabase > API Keys > Secret keys)
# LƯU Ý: Không commit giá trị thật lên GitHub. Hãy cấu hình trực tiếp trên Render Dashboard.
SUPABASE_SERVICE_KEY=your_supabase_secret_key_here

# Cấu hình JWT Token
# Tạo giá trị riêng: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_PRIVATE_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Cross-Origin & Nghiệp vụ điểm danh GPS (Haversine 200m)
CORS_ORIGIN=*
CHECK_IN_RADIUS_METERS=200
