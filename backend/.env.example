PORT=3000
# Replace with the PostgreSQL connection string from Supabase > Connect > Transaction pooler.
# Do not use the https://<project-ref>.supabase.co API URL here.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h
CORS_ORIGIN=*
CHECK_IN_RADIUS_METERS=200
